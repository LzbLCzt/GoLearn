    checkPeriod: 30s
    chain:
    - errorCount
    - errorRate
    - errorCheck
    sleepWindow: 30s
    requestCountAfterHalfOpen: 10
    successCountAfterHalfOpen: 8
    recoverWindow: 1m0s
    recoverNumBuckets: 10
    plugin:
